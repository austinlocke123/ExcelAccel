{
  "schema_version": 1,
  "profile_id": "excelaccel.default.v1",
  "font_color_cycle": ["#000000", "#0000FF", "#008000", "#FF0000"],
  "fill_color_cycle": ["#FFFFFF", "#FFF2CC", "#D9EAD3", "#F4CCCC"],
  "font_size_cycle": [8, 9, 10, 11, 12, 14],
  "number_formats": {
    "boolean": "Yes;Yes;No",
    "currency": "$#,##0.00;($#,##0.00);-",
    "date": "m/d/yyyy",
    "general": "General",
    "multiple": "0.0x",
    "percentage": "0.0%"
  },
  "quick_keys": [
    { "command_id": "inspect.selection.summary", "sequence": "CTRL+SHIFT+K,I" },
    { "command_id": "format.number.currency", "sequence": "CTRL+SHIFT+K,C" }
  ],
  "immediate_preview_cell_limit": 50000,
  "wrap_sheet_navigation": true
}
